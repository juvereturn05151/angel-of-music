# Local development settings. Do not put secrets in this file.
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Keep "mock" for the no-secrets demo. Use "huggingface" for real visual analysis.
VISUAL_ANALYZER_PROVIDER=mock
HUGGINGFACE_VISION_MODEL=google/gemma-3-4b-it
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_TIMEOUT_SECONDS=60

# Put your real token only in .env, never in .env.example.
HF_TOKEN=
