{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Angel of Music Evaluation Manifest",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "image_placeholder", "rights_status", "notes"],
        "properties": {
          "id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "peaceful fantasy",
              "mystery",
              "danger",
              "heroic",
              "melancholic",
              "comedic",
              "science fiction",
              "horror",
              "ambiguous",
              "abstract"
            ]
          },
          "image_placeholder": { "type": "string" },
          "rights_status": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
